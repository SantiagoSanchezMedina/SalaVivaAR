  m_Script: {fileID: 11500000, guid: ffbebdc871b1b7b4dbb392b9e5a1a122, type: 3}
  m_Name: CabezaOlmeca
  m_EditorClassIdentifier: Assembly-CSharp::PiezaData
  id: cabeza_olmeca
  nombre: Cabeza colosal 6
  sala: Costa del Golfo
  colorSala: {r: 0.18039216, g: 0.36078432, b: 0.5019608, a: 1}
  insignia: {fileID: 21300000, guid: 136671d18e2e1e548af0c52325044c9a, type: 3}
  insigniaBloqueada: {fileID: 21300000, guid: fd702ee30bbf87a42a3437bc90ebe873, type: 3}
  cultura: Olmeca
  epoca: "Precl\xE1sico (c. 1200\u2013900 a.C.)"
  material: Basalto
  medidas: "1.67 m de alto \xB7 1.41 m de ancho"
  procedencia: San Lorenzo Tenochtitlan, Veracruz (Monumento 17)
  hallazgo: 
  curiosidades:
  - "Solo se conocen 17 cabezas colosales olmecas y 10 provienen de San Lorenzo.
    En este museo hay \xFAnicamente dos."
  - "El basalto se trajo del Cerro Cintepec, en la sierra de Los Tuxtlas, a decenas
    de kil\xF3metros: sin rueda ni animales de carga, quiz\xE1 con balsas por los
    r\xEDos y troncos rodantes en tierra."
  - "Cada cabeza tiene rasgos \xFAnicos, por eso se cree que son retratos de gobernantes
    olmecas."
  - El tocado en forma de casco pudo usarse en la batalla o en el juego de pelota
    mesoamericano.
  enElMuseo: "Est\xE1 en la Sala de las Culturas de la Costa del Golfo, en el ala
    sur de la planta baja. Es una de las dos cabezas colosales olmecas que resguarda
    el museo."
  fuente: "INAH \xB7 Museo Nacional de Antropolog\xEDa"
  nombreVista: Escala real
  textoVista: 'Mide 1.67 m de alto: casi lo mismo que una persona de 1.70 m.'
  medidaRealMetros: 1.67
